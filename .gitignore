# controle para não repetir NOME/CPF dentro da mesma execução
_USADOS_NOMES = set()
_USADOS_CPFS = set()

def _gerar_cpf_valido():
    """Gera CPF válido (11 dígitos) com dígitos verificadores corretos. Não repete dentro da execução."""
    for _ in range(100):
        base = [random.randint(0,9) for _ in range(9)]
        # evita CPFs com todos dígitos iguais
        if len(set(base)) == 1:
            continue
        # primeiro dígito
        s1 = sum((10 - i) * base[i] for i in range(9))
        d1 = (s1 * 10) % 11
        d1 = 0 if d1 == 10 else d1
        # segundo dígito
        s2 = sum((11 - i) * base[i] for i in range(9)) + d1 * 2
        d2 = (s2 * 10) % 11
        d2 = 0 if d2 == 10 else d2
        cpf_digits = base + [d1, d2]
        cpf_str = "".join(map(str, cpf_digits))
        if cpf_str in _USADOS_CPFS:
            continue
        # evita sequências inválidas conhecidas
        if cpf_str in ("00000000000","11111111111","22222222222","33333333333","44444444444","55555555555","66666666666","77777777777","88888888888","99999999999"):
            continue
        _USADOS_CPFS.add(cpf_str)
        return cpf_str
    # fallback
    return "12845677618"

def _formatar_cpf(cpf_digits):
    c = re.sub(r"\D","", cpf_digits)
    return f"{c[:3]}.{c[3:6]}.{c[6:9]}-{c[9:]}"

def _gerar_nome_valido():
    """Gera nome completo válido 2-3 partes. Não repete dentro da execução."""
    for _ in range(100):
        primeiro = random.choice(_PRIMEIROS)
        meio = random.choice(_SOBRENOMES) if random.random() > 0.3 else ""
        ultimo = random.choice(_SOBRENOMES)
        # evita mesmo sobrenome repetido
        if meio and meio == ultimo:
            ultimo = random.choice([s for s in _SOBRENOMES if s != meio])
        nome = f"{primeiro} {meio} {ultimo}".replace("  ", " ").strip() if meio else f"{primeiro} {ultimo}"
        nome = re.sub(r'\s+',' ', nome).strip()
        if nome not in _USADOS_NOMES and len(nome) >= 5 and " " in nome and re.match(r"^[A-Za-zÀ-ÿ' .-]+$", nome):
            _USADOS_NOMES.add(nome)
            return nome.title()
    return "Toddy Admin"

def _gerar_email(nome):
    base = re.sub(r'[^a-z]', '', nome.lower().replace(' ', '.').replace('ã','a').replace('ç','c').replace('é','e').replace('í','i').replace('ó','o').replace('ú','u').replace('â','a').replace('ô','o'))
    # remove acentos restantes
    base = re.sub(r'\.+', '.', base).strip('.')
    if not base or len(base) < 3:
        base = f"user{random.randint(1000,9999)}"
    num = random.randint(1, 9999)
    dom = random.choice(_EMAIL_DOMAINS)
    # 70% com número, 30% sem
    if random.random() > 0.3:
        return f"{base}{num}@{dom}"
    else:
        return f"{base}@{dom}"

def _gerar_telefone():
    ddd = random.choice(_DDD_VALIDOS)
    # celular 9xxxx-xxxx (9 dígitos com 9 na frente)
    prefix = "9" + "".join(str(random.randint(0,9)) for _ in range(4))
    suffix = "".join(str(random.randint(0,9)) for _ in range(4))
    digits = f"{ddd}{prefix}{suffix}"
    formatted = f"({ddd}) {prefix}-{suffix}"
    return formatted, digits

def _gerar_numero_casa():
    # pode repetir (1-2500)
    return str(random.randint(1, 2500))

def gerar_dados_cliente():
    """Gera dados completos aleatórios por CARD. Retorna (cliente_dict, endereco_dict, holder_name, holder_document)."""
    nome = _gerar_nome_valido()
    cpf_digits = _gerar_cpf_valido()
    cpf_fmt = _formatar_cpf(cpf_digits)
    email = _gerar_email(nome)
    tel_fmt, tel_digits = _gerar_telefone()
    numero = _gerar_numero_casa()
    cliente = {
        "nome": nome,
        "email": email,
        "telefone": tel_fmt,
        "cpf": cpf_fmt,
    }
    endereco = {
        "cep": ENDERECO_BASE["cep"],
        "endereco": ENDERECO_BASE["endereco"],
        "numero": numero,
        "complemento": "",
        "bairro": ENDERECO_BASE["bairro"],
        "cidade": ENDERECO_BASE["cidade"],
        "uf": ENDERECO_BASE["uf"],
    }
    # holder para PagarMe (sem máscara)
    holder_name = nome.upper()
    holder_document = cpf_digits
    return cliente, endereco, holder_name, holder_document, tel_digits

