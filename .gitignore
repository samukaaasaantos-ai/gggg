    escolha = random.choice(disponiveis)
    _USADOS_PRODUTOS.add(escolha[0])
    pid, nome, preco = escolha
    preco_str = f"R$ {preco:.2f}".replace(".", ",")
    _ULTIMO_PRODUTO = {"id": pid, "nome": nome, "preco": preco, "preco_str": preco_str}
    return pid, nome, preco, preco_str

